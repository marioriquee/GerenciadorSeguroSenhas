{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gerenciador Seguro de Senhas",
  "version": "0.1.0",
  "identifier": "br.com.marioriquee.gerenciadorseguro",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gerenciador Seguro de Senhas",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
