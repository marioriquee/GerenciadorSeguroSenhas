# Servidor web da aplicacao
PORT=8090
HOST=192.168.137.2

# Provedor de dados: sqlserver ou file
DB_PROVIDER=sqlserver

# Usado no modo file e para gerar master.key se APP_MASTER_KEY ficar vazio
DATA_DIR=./data

# Use true somente quando estiver rodando com HTTPS
APP_COOKIE_SECURE=false

# Chave de 32 bytes em hex ou base64 para criptografar as senhas do cofre
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=

# Codigo obrigatorio para criar o primeiro administrador
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_SETUP_TOKEN=

# SQL Server / SSMS
SQLSERVER_HOST=192.168.176.19
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=Senhas
SQLSERVER_USER=DesenvolvimentoLar
SQLSERVER_PASSWORD=LarDB842

# Para rede interna sem certificado configurado
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Se usar instancia nomeada, preencha e deixe SQLSERVER_PORT sem uso
# SQLSERVER_INSTANCE=SQLEXPRESS

# Tabelas do banco
SQLSERVER_TABLE_USUARIOS=dbo.fatoUsuarios
SQLSERVER_TABLE_SENHAS=dbo.fatoSenhasCofre
SQLSERVER_TABLE_AUDITORIA=dbo.fatoAuditoria

# Valores gravados na coluna Perfil
SQLSERVER_ROLE_ADMIN=administrador
SQLSERVER_ROLE_USER=usuario

